{
  "name": "growthos",
  "version": "0.1.0",
  "private": true,
  "description": "GrowthOS v4 monorepo scaffold",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "smoke:infra": "pnpm --filter @growthos/infra-smoke smoke",
    "migrate:dry-run": "pnpm --filter @growthos/db migrate:dry-run",
    "atlas:validate": "pnpm --filter @growthos/db db:atlas-validate",
    "atlas:lint": "pnpm --filter @growthos/db db:atlas-lint",
    "migrate:apply": "pnpm --filter @growthos/db db:migrate-apply",
    "seed:dev": "pnpm --filter @growthos/db db:seed-dev",
    "infra:up": "docker compose -f compose.yaml up -d",
    "infra:down": "docker compose -f compose.yaml down -v",
    "infra:ps": "docker compose -f compose.yaml ps",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.21",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
