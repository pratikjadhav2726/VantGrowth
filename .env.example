# =============================================================================
# GrowthOS — environment variables reference
# =============================================================================
# Copy to .env and fill in real values for local dev.
# All values below are safe defaults for `docker compose -f compose.dev.yaml up`.
# Lines marked [required] have no safe default — you must supply them.
# =============================================================================

# ── Runtime identity ──────────────────────────────────────────────────────────
# UUID of the "dev" tenant created by `pnpm seed:dev`.
GROWTHOS_DEV_TENANT_ID=00000000-0000-0000-0001-000000000001

# Bearer token the web shell uses when calling mutation API routes.
# Any non-empty string works in dev. Must match GROWTHOS_API_SERVICE_TOKEN.
GROWTHOS_API_SERVICE_TOKEN=growthos-dev-service-token

# ── Database ──────────────────────────────────────────────────────────────────
# Points to the Postgres container started by compose.dev.yaml.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/growthos_ci

# ── NATS JetStream ────────────────────────────────────────────────────────────
NATS_SERVERS=nats://nats:4222

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001

# ── Web app ───────────────────────────────────────────────────────────────────
# Internal URL the web app uses to call the API (container-to-container).
GROWTHOS_API_BASE_URL=http://api:3001
# Public URL exposed to the browser (must be reachable from localhost).
NEXT_PUBLIC_GROWTHOS_API_BASE_URL=http://localhost:3001
# Public tenant id echoed to client-side components.
NEXT_PUBLIC_GROWTHOS_DEV_TENANT_ID=00000000-0000-0000-0001-000000000001
# Secret used to sign session cookies. Any 32+ char random string.
GROWTHOS_SESSION_SECRET=dev-session-secret-change-in-production

# ── OpenAI ────────────────────────────────────────────────────────────────────
# [required for LLM features — leave blank to disable signal grading / drafts]
OPENAI_API_KEY=

# ── Paperclip (project management backend) ────────────────────────────────────
# GrowthOS API runs in Docker and reaches Paperclip by service name.
# For host-only API runs, use http://localhost:3100 instead.
PAPERCLIP_BASE_URL=http://paperclip:3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=lan
# Local dev placeholder. In authenticated/private Paperclip deployments,
# replace with a real board API key generated by Paperclip.
PAPERCLIP_SERVICE_TOKEN=growthos-paperclip-dev-token
PAPERCLIP_TIMEOUT_MS=10000
GROWTHOS_REQUIRE_PAPERCLIP=false
GROWTHOS_DOCKER_NETWORK=growthos-n8n-local_default

# ── n8n (single external integration connector) ───────────────────────────────
# n8n owns downstream SaaS credentials and workflows. GrowthOS receives
# normalized signals and sends approved dispatch requests back to n8n.
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_ENCRYPTION_KEY=growthos-dev-n8n-encryption-key-change-me
N8N_SHARED_SECRET=growthos-dev-n8n-shared-secret
N8N_DISPATCH_WEBHOOK_URL=http://host.docker.internal:5678/webhook/growthos/dispatch
N8N_TIMEOUT_MS=10000

# The outbox publisher drains approved external actions to n8n.
OUTBOX_TENANT_IDS=00000000-0000-0000-0001-000000000001
OUTBOX_BATCH_SIZE_PER_TENANT=100
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_ENABLE_LISTEN_NOTIFY=true

# ── Restate (durable workflow engine) ────────────────────────────────────────
# Leave blank in dev — workflow routes return 503 when unconfigured.
RESTATE_BASE_URL=
RESTATE_API_KEY=
RESTATE_CALLBACK_SECRET=

# ── ClickHouse (LLM call log sink) ────────────────────────────────────────────
# Points to the ClickHouse container in compose.dev.yaml.
# Remove to disable LLM call logging (safe for dev).
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CREDENTIALS=default:

# ── MinIO (S3-compatible object store) ────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniosecret
MINIO_REGION=us-east-1

# ── Gitea (per-tenant workspace repos) ────────────────────────────────────────
# Leave blank in dev — provisioning skips Gitea step when unconfigured.
GITEA_BASE_URL=http://gitea:3000
GITEA_TOKEN=
GITEA_OWNER=growthos
GITEA_TEMPLATE_OWNER=growthos

# ── OpenBao / Vault (secrets backend) ─────────────────────────────────────────
VAULT_ADDR=http://openbao:8200
VAULT_TOKEN=growthos-dev-root-token

# ── Postal (founder digest email delivery) ────────────────────────────────────
# Leave blank — digest endpoint returns { sent: false, reason: "postal_not_configured" }.
POSTAL_API_KEY=
POSTAL_SERVER_URL=
POSTAL_FROM_EMAIL=digest@growthos.io
GROWTHOS_DIGEST_RECIPIENT_EMAIL=

# ── Zitadel (tenant identity) ─────────────────────────────────────────────────
# Leave blank in dev — provisioning uses StubZitadelClient when unconfigured.
ZITADEL_DOMAIN=
ZITADEL_TOKEN=

# ── Lago (usage billing) ──────────────────────────────────────────────────────
# Leave blank in dev — provisioning uses StubBillingClient when unconfigured.
LAGO_API_URL=
LAGO_API_KEY=

# ── Critique worker thresholds (optional) ─────────────────────────────────────
# Defaults: approve >= 0.8, revise >= 0.5. Override per deployment.
# CRITIQUE_APPROVE_THRESHOLD=0.8
# CRITIQUE_REVISE_THRESHOLD=0.5

# ── Observability (optional) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# LOG_LEVEL=info
