# =============================================================================
# GrowthOS — environment variables reference
# =============================================================================
# Copy to .env and fill in real values for local dev.
# All values below are safe defaults for `docker compose -f compose.dev.yaml up`.
# Lines marked [required] have no safe default — you must supply them.
# =============================================================================

# ── Runtime identity ──────────────────────────────────────────────────────────
# UUID of the "dev" tenant created by `pnpm seed:dev`.
GROWTHOS_DEV_TENANT_ID=00000000-0000-0000-0001-000000000001

# Bearer token the web shell uses when calling mutation API routes.
# Any non-empty string works in dev. Must match GROWTHOS_API_SERVICE_TOKEN.
GROWTHOS_API_SERVICE_TOKEN=growthos-dev-service-token

# ── Database ──────────────────────────────────────────────────────────────────
# Points to the Postgres container started by compose.dev.yaml.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/growthos_ci

# ── NATS JetStream ────────────────────────────────────────────────────────────
NATS_SERVERS=nats://nats:4222

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001

# ── Web app ───────────────────────────────────────────────────────────────────
# Internal URL the web app uses to call the API (container-to-container).
GROWTHOS_API_BASE_URL=http://api:3001
# Public URL exposed to the browser (must be reachable from localhost).
NEXT_PUBLIC_GROWTHOS_API_BASE_URL=http://localhost:3091
# Public tenant id echoed to client-side components.
NEXT_PUBLIC_GROWTHOS_DEV_TENANT_ID=00000000-0000-0000-0001-000000000001
# Secret used to sign session cookies. Any 32+ char random string.
GROWTHOS_SESSION_SECRET=dev-session-secret-change-in-production

# ── OpenAI ────────────────────────────────────────────────────────────────────
# [required for LLM features — leave blank to disable signal grading / drafts]
OPENAI_API_KEY=

# ── Paperclip (project management backend) ────────────────────────────────────
# GrowthOS API runs in Docker and reaches Paperclip by service name.
# For host-only API runs, use http://localhost:3100 instead.
PAPERCLIP_BASE_URL=http://paperclip:3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=lan
# Local dev placeholder. In authenticated/private Paperclip deployments,
# replace with a real board API key generated by Paperclip.
PAPERCLIP_SERVICE_TOKEN=growthos-paperclip-dev-token
PAPERCLIP_TIMEOUT_MS=10000
GROWTHOS_REQUIRE_PAPERCLIP=false
# External network shared by compose.dev.yaml, compose.paperclip.yaml, and
# compose.worker.yaml. Override only when your deployment uses another network.
GROWTHOS_DOCKER_NETWORK=growthos-dev_default

# ── Paperclip heartbeat → GrowthOS durable handoff ───────────────────────────
# The heartbeat worker is intentionally idle/dry-run until these are configured.
# Every Paperclip company must map explicitly to its owning GrowthOS tenant UUID.
# Example:
# PAPERCLIP_HEARTBEAT_COMPANY_IDS=6089ae0f-8e93-4233-bb68-41aa29fbf561
# PAPERCLIP_HEARTBEAT_COMPANY_TENANT_MAP={"6089ae0f-8e93-4233-bb68-41aa29fbf561":"00000000-0000-0000-0001-000000000001"}
PAPERCLIP_HEARTBEAT_COMPANY_IDS=
PAPERCLIP_HEARTBEAT_COMPANY_TENANT_MAP={}
PAPERCLIP_HEARTBEAT_POLL_MS=15000
PAPERCLIP_HEARTBEAT_RUNNABLE_STATUSES=todo,backlog
PAPERCLIP_HEARTBEAT_DRY_RUN=true

# ── n8n (single external integration connector) ───────────────────────────────
# n8n owns downstream SaaS credentials and workflows. GrowthOS receives
# normalized signals and sends approved dispatch requests back to n8n.
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_ENCRYPTION_KEY=growthos-dev-n8n-encryption-key-change-me
N8N_SHARED_SECRET=growthos-dev-n8n-shared-secret
N8N_DISPATCH_WEBHOOK_URL=http://host.docker.internal:5678/webhook/growthos/dispatch
# Callback URL used by the bundled Compose n8n profile. If n8n runs on the
# host or outside Compose, override this with its reachable public URL, e.g.
# http://host.docker.internal:3091/v1/n8n/dispatch-results.
N8N_DISPATCH_RESULT_CALLBACK_URL=http://api:3001/v1/n8n/dispatch-results
N8N_TIMEOUT_MS=10000
N8N_DISPATCH_LEASE_MS=120000

# The outbox publisher drains approved external actions to n8n.
# It also forwards `paperclip.work.ready.v1` events. Include every tenant in
# PAPERCLIP_HEARTBEAT_COMPANY_TENANT_MAP here or those durable events will wait
# in the outbox without being published.
OUTBOX_TENANT_IDS=00000000-0000-0000-0001-000000000001
OUTBOX_BATCH_SIZE_PER_TENANT=100
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_ENABLE_LISTEN_NOTIFY=true

# ── Durable GTM motion workers ───────────────────────────────────────────────
# `compose.dev.yaml` starts this chain automatically:
# signal inbox → intel → content brief → blog draft → critique → learning,
# plus tenant-scoped attribution and warmth consumers.
# Use stable names for durables across restarts; values below are safe defaults.
SIGNAL_ROUTER_TENANT_IDS=00000000-0000-0000-0001-000000000001
SIGNAL_ROUTER_BATCH_SIZE_PER_SIGNAL_TYPE=50
SIGNAL_ROUTER_POLL_INTERVAL_MS=1000
# Claim leases make the polling inbox safe to scale horizontally. Set the owner
# only when a deployment needs a human-readable replica identity.
SIGNAL_ROUTER_CLAIM_LEASE_MS=60000
# SIGNAL_ROUTER_CLAIM_OWNER=
GROWTHOS_JETSTREAM_STREAM=GROWTHOS

# Bound every JetStream worker's retry window. Exhausted work is written as a
# durable `worker.dead_lettered.v1` event for control-plane visibility.
INTEL_REQUEST_ACK_WAIT_MS=60000
INTEL_REQUEST_MAX_DELIVER=5
INTEL_REQUEST_RETRY_DELAY_MS=5000
CONTENT_BRIEF_ACK_WAIT_MS=60000
CONTENT_BRIEF_MAX_DELIVER=5
CONTENT_BRIEF_RETRY_DELAY_MS=5000
BLOG_DRAFT_ACK_WAIT_MS=60000
BLOG_DRAFT_MAX_DELIVER=5
BLOG_DRAFT_RETRY_DELAY_MS=5000
CRITIQUE_REQUEST_ACK_WAIT_MS=60000
CRITIQUE_REQUEST_MAX_DELIVER=5
CRITIQUE_REQUEST_RETRY_DELAY_MS=5000
LEARNING_SIGNAL_ACK_WAIT_MS=60000
LEARNING_SIGNAL_MAX_DELIVER=5
LEARNING_SIGNAL_RETRY_DELAY_MS=5000
LEARNING_CRITIQUE_ACK_WAIT_MS=60000
LEARNING_CRITIQUE_MAX_DELIVER=5
LEARNING_CRITIQUE_RETRY_DELAY_MS=5000

# Tenant provisioning callbacks consume the durable request event only after
# every lifecycle update is in the outbox. Exhausted deliveries become
# `worker.dead_lettered.v1` events for the control plane.
WORKFLOW_CALLBACK_REQUEST_SUBJECT=t.*.workflow.tenant_provisioning.requested.v1
WORKFLOW_CALLBACK_REQUEST_DURABLE_NAME=growthos_workflow_callback
WORKFLOW_CALLBACK_REQUEST_QUEUE_GROUP=growthos-worker-workflow-callback
WORKFLOW_CALLBACK_REQUEST_ACK_WAIT_MS=60000
WORKFLOW_CALLBACK_REQUEST_MAX_DELIVER=5
WORKFLOW_CALLBACK_REQUEST_RETRY_DELAY_MS=5000
WORKFLOW_CALLBACK_REQUEST_MAX_ACK_PENDING=25
# Local development uses idempotent provisioning stubs. In production set this
# false and configure RESTATE_BASE_URL, or explicitly enable real clients.
ENABLE_DIRECT_PROVISIONING=true
# ENABLE_REAL_GITEA_CLIENT=false
# ENABLE_REAL_MINIO_CLIENT=false
# ENABLE_REAL_ZITADEL_CLIENT=false
# ENABLE_REAL_LAGO_CLIENT=false

# Sales attribution and outbound warmth are outbox-only: producers enqueue
# snake_case `attribution.signal.v1` / `warmth.signal.v1` events and the
# outbox publisher delivers them to the tenant-scoped JetStream subjects.
ATTRIBUTION_SIGNAL_SUBJECT=t.*.attribution.signal.v1
ATTRIBUTION_SIGNAL_DURABLE_NAME=growthos_attribution
ATTRIBUTION_SIGNAL_QUEUE_GROUP=growthos-worker-attribution
ATTRIBUTION_SIGNAL_ACK_WAIT_MS=60000
ATTRIBUTION_SIGNAL_MAX_DELIVER=5
ATTRIBUTION_SIGNAL_RETRY_DELAY_MS=5000
ATTRIBUTION_SIGNAL_MAX_ACK_PENDING=25
WARMTH_SIGNAL_SUBJECT=t.*.warmth.signal.v1
WARMTH_SIGNAL_DURABLE_NAME=growthos_warmth
WARMTH_SIGNAL_QUEUE_GROUP=growthos-worker-warmth
WARMTH_SIGNAL_ACK_WAIT_MS=60000
WARMTH_SIGNAL_MAX_DELIVER=5
WARMTH_SIGNAL_RETRY_DELAY_MS=5000
WARMTH_SIGNAL_MAX_ACK_PENDING=25

# ── Restate (durable workflow engine) ────────────────────────────────────────
# Leave blank in dev — workflow routes return 503 when unconfigured.
RESTATE_BASE_URL=
RESTATE_API_KEY=
RESTATE_CALLBACK_SECRET=

# ── ClickHouse (LLM call log sink) ────────────────────────────────────────────
# Points to the ClickHouse container in compose.dev.yaml.
# Remove to disable LLM call logging (safe for dev).
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CREDENTIALS=default:

# ── MinIO (S3-compatible object store) ────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniosecret
MINIO_REGION=us-east-1

# ── Gitea (per-tenant workspace repos) ────────────────────────────────────────
# Leave blank in dev — provisioning skips Gitea step when unconfigured.
GITEA_BASE_URL=http://gitea:3000
GITEA_TOKEN=
GITEA_OWNER=growthos
GITEA_TEMPLATE_OWNER=growthos

# ── OpenBao / Vault (secrets backend) ─────────────────────────────────────────
VAULT_ADDR=http://openbao:8200
VAULT_TOKEN=growthos-dev-root-token

# ── Postal (founder digest email delivery) ────────────────────────────────────
# Leave blank — digest endpoint returns { sent: false, reason: "postal_not_configured" }.
POSTAL_API_KEY=
POSTAL_SERVER_URL=
POSTAL_FROM_EMAIL=digest@growthos.io
GROWTHOS_DIGEST_RECIPIENT_EMAIL=

# ── Zitadel (tenant identity) ─────────────────────────────────────────────────
# Leave blank in dev — provisioning uses StubZitadelClient when unconfigured.
ZITADEL_DOMAIN=
ZITADEL_TOKEN=

# ── Lago (usage billing) ──────────────────────────────────────────────────────
# Leave blank in dev — provisioning uses StubBillingClient when unconfigured.
LAGO_API_URL=
LAGO_API_KEY=

# ── Critique worker thresholds (optional) ─────────────────────────────────────
# Defaults: approve >= 0.8, revise >= 0.5. Override per deployment.
# CRITIQUE_APPROVE_THRESHOLD=0.8
# CRITIQUE_REVISE_THRESHOLD=0.5

# ── Observability (optional) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# LOG_LEVEL=info
